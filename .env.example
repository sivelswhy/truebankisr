# Optional settings. Copy to .env.local. Credentials are entered in the app.
# Part of the Leumi account number to use if you have several.
LEUMI_ACCOUNT_NUMBER=
# Day of the month Max is debited from the bank.
BILLING_DAY=2
# 1 = show the Chromium window while scraping (debugging).
SHOW_BROWSER=0
# Background refresh interval while the server runs (0 = off). Daytime only.
REFRESH_MINUTES=60
