{
  "sourceLanguage": "en",
  "strings": {
    "After Max · %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après Max · %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחרי מקס · %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После Макса · %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد ماكس · %@"
          }
        }
      }
    },
    "Open True Balance to connect your accounts.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre True Balance pour connecter tes comptes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את True Balance כדי לחבר את החשבונות."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте True Balance, чтобы подключить счета."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح True Balance لربط حساباتك."
          }
        }
      }
    },
    "Really available": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraiment disponible"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זמין באמת"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реально доступно"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المتاح فعلًا"
          }
        }
      }
    },
    "True balance": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrai solde"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יתרה אמיתית"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настоящий баланс"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرصيد الحقيقي"
          }
        }
      }
    },
    "What’s really available after the next Max debit.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est vraiment disponible après le prochain prélèvement Max."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה זמין באמת אחרי חיוב מקס הבא."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что реально доступно после следующего списания Макса."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هو متاح فعلًا بعد خصم ماكس القادم."
          }
        }
      }
    },
    "about %@/day": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "environ %@/jour"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בערך %@ ליום"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "около %@ в день"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحو %@ يوميًا"
          }
        }
      }
    },
    "₪ %@ available": {
      "localizations": {
