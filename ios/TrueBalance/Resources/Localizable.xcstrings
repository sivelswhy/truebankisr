{
  "sourceLanguage": "en",
  "strings": {
    "%@ a year": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par an"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ בשנה"
          }
        }
      }
    },
    "%@ account": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון %@"
          }
        }
      }
    },
    "%@ account (not counted, no rate)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte %@ (non compté, pas de taux)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון %@ (לא נכלל, אין שער)"
          }
        }
      }
    },
    "%@ asked for an extra verification step. Sign in once on their website, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a demandé une vérification supplémentaire. Connecte-toi une fois sur leur site, puis réessaie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ביקשו שלב אימות נוסף. יש להתחבר פעם אחת באתר שלהם ואז לנסות שוב."
          }
        }
      }
    },
    "%@ asks you to change your password. Do it on their site, then sign in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te demande de changer ton mot de passe. Fais-le sur leur site, puis reconnecte-toi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ מבקשים להחליף סיסמה. יש להחליף אותה באתר שלהם ואז להתחבר שוב."
          }
        }
      }
    },
    "%@ at the Bank of Israel rate": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ au taux de la Banque d’Israël"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לפי שער בנק ישראל"
          }
        }
      }
    },
    "%@ budget used up": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budget %@ épuisé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקציב של %@ נוצל"
          }
        }
      }
    },
    "%@ didn’t accept this username or password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas accepté cet identifiant ou ce mot de passe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לא קיבלו את שם המשתמש או הסיסמה."
          }
        }
      }
    },
    "%@ left": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "reste %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נותרו %@"
          }
        }
      }
    },
    "%@ over": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de dépassement"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חריגה של %@"
          }
        }
      }
    },
    "%@ refused the connection from this network. This happens from abroad or through a VPN: turn the VPN off or try another network.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé la connexion depuis ce réseau. Cela arrive depuis l’étranger ou via un VPN : désactivez le VPN ou essayez un autre réseau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ דחו את החיבור מהרשת הזאת. זה קורה מחו״ל או דרך VPN: כדאי לכבות את ה-VPN או לנסות רשת אחרת."
          }
        }
      }
    },
    "%@ so far": {
      "extractionState": "stale",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pour l’instant"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ עד עכשיו"
          }
        }
      }
    },
    "%@ spent": {
      "localizations": {
