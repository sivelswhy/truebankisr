    "The .pem file downloaded from the Enable Banking portal. It’s kept in this iPhone’s Keychain.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier .pem téléchargé depuis le portail Enable Banking. Il est conservé dans le trousseau de cet iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ ה-‎.pem שהורד מהפורטל של Enable Banking. הוא נשמר במחזיק המפתחות של האייפון הזה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл .pem, скачанный с портала Enable Banking. Он хранится в связке ключей этого iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف ‎.pem الذي نزّلته من بوابة Enable Banking. يُحفظ في سلسلة مفاتيح هذا الـ iPhone."
          }
        }
      }
    },
    "The bank didn’t give access. Try connecting again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque n’a pas donné l’accès. Réessayez de la connecter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבנק לא אישר גישה. אפשר לנסות להתחבר שוב."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк не предоставил доступ. Попробуйте подключиться снова."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يمنح البنك الوصول. حاول الربط مجددًا."
          }
        }
      }
    },
    "The bank limits how often it can be read. Try again later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque limite le nombre de lectures. Réessayez plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבנק מגביל את מספר הקריאות. אפשר לנסות שוב מאוחר יותר."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банк ограничивает частоту запросов. Повторите попытку позже."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّ البنك من عدد مرات القراءة. حاول لاحقًا."
          }
        }
      }
    },
    "The username and password you use on leumi.co.il.": {
      "localizations": {
