    "See what you can really spend: your Leumi balance minus the Max charges still to come.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vois ce que tu peux vraiment dépenser : ton solde Leumi moins les dépenses Max encore à venir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה אפשר באמת להוציא: היתרה בלאומי פחות חיובי מקס שעוד יגיעו."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте, сколько вы реально можете потратить: баланс Леуми минус ещё не списанные покупки по Максу."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف ما يمكنك إنفاقه فعلًا: رصيدك في لئومي ناقص خصومات ماكس القادمة."
          }
        }
      }
    },
    "Sender": {
      "localizations": {
        "fr": {
          "stringUnit": {
