            "state": "translated",
            "value": "כולל תשלומים עתידיים שכבר התחייבת להם: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С учётом уже взятых будущих платежей: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع الأقساط اللاحقة الملتزم بها: %@"
          }
        }
      }
    },
    "Work": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עבודה"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работа"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العمل"
          }
        }
      }
    },
    "You confirm on the bank’s site or app, then come back here. Access is read only and lasts 180 days.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous confirmez sur le site ou l’app de la banque, puis vous revenez ici. L’accès est en lecture seule et dure 180 jours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאשרים באתר או באפליקציה של הבנק וחוזרים לכאן. הגישה לקריאה בלבד ונמשכת 180 יום."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы подтверждаете доступ на сайте или в приложении банка и возвращаетесь сюда. Доступ только для чтения и действует 180 дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تؤكّد على موقع البنك أو تطبيقه ثم تعود إلى هنا. الوصول للقراءة فقط ويدوم 180 يومًا."
          }
        }
      }
    },
    "You stay signed in. Your credentials are kept in this iPhone’s Keychain.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu restes connecté. Tes identifiants sont gardés dans le trousseau de cet iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשארים מחוברים. פרטי ההתחברות נשמרים במחזיק המפתחות של האייפון הזה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход сохраняется. Данные для входа хранятся в связке ключей этого iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مسجّل الدخول. تُحفظ بيانات دخولك في سلسلة مفاتيح هذا الـ iPhone."
          }
        }
      }
    },
    "Your %@ account is blocked. Contact %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %1$@ account is blocked. Contact %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte %1$@ est bloqué. Contacte %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון ב%1$@ חסום. יש לפנות ל%2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш счёт в %1$@ заблокирован. Обратитесь в %2$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسابك في %1$@ محظور. تواصل مع %2$@."
          }
        }
      }
    },
    "Your Leumi and Max credentials and the saved balance will be deleted from this iPhone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes identifiants Leumi et Max et le solde enregistré seront supprimés de cet iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרטי ההתחברות ללאומי ולמקס והיתרה השמורה יימחקו מהאייפון הזה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные для входа в Леуми и Макс и сохранённый баланс будут удалены с этого iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف بيانات دخولك إلى لئومي وماكس والرصيد المحفوظ من هذا الـ iPhone."
          }
        }
      }
    },
    "Your Leumi and Max credentials, the other banks’ access and the saved balances will be deleted from this iPhone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos identifiants Leumi et Max, l’accès aux autres banques et les soldes enregistrés seront supprimés de cet iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרטי ההתחברות ללאומי ולמקס, הגישה לבנקים הנוספים והיתרות השמורות יימחקו מהאייפון הזה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные для входа в Леуми и Макс, доступ к другим банкам и сохранённые балансы будут удалены с этого iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف بيانات دخولك إلى لئومي وماكس، والوصول إلى البنوك الأخرى، والأرصدة المحفوظة من هذا الـ iPhone."
          }
        }
      }
    },
    "Your Leumi balance minus the next Max debit, from the last update.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton solde Leumi moins le prochain prélèvement Max, d’après la dernière mise à jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היתרה בלאומי פחות חיוב מקס הבא, לפי העדכון האחרון."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс Леуми минус следующее списание Макса, по последнему обновлению."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصيدك في لئومي ناقص خصم ماكس القادم، حسب آخر تحديث."
          }
        }
      }
    },
    "Your credentials are stored in this iPhone’s Keychain and never leave it, except to sign in to Leumi and Max.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes identifiants sont stockés dans le trousseau de cet iPhone et n’en sortent jamais, sauf pour te connecter à Leumi et Max."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרטי ההתחברות נשמרים במחזיק המפתחות של האייפון ולא יוצאים ממנו, חוץ מההתחברות ללאומי ולמקס."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные для входа хранятся в связке ключей этого iPhone и не покидают его, кроме как для входа в Леуми и Макс."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ بيانات دخولك في سلسلة مفاتيح هذا الـ iPhone ولا تغادره أبدًا، إلا لتسجيل الدخول إلى لئومي وماكس."
          }
        }
      }
    },
    "Your first name": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton prénom"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם הפרטי שלך"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше имя"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمك الأول"
          }
        }
      }
    },
    "Your true balance is %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton vrai solde est de %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היתרה האמיתית שלך היא %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш настоящий баланс: %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصيدك الحقيقي %@."
          }
        }
      }
    },
    "Your true balance is %@. Updated %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your true balance is %1$@. Updated %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton vrai solde est de %1$@. Mis à jour %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היתרה האמיתית שלך היא %1$@. עודכן %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш настоящий баланс: %1$@. Обновлено %2$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصيدك الحقيقي %1$@. آخر تحديث %2$@."
          }
        }
      }
    },
    "Your true balance is below %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton vrai solde est passé sous %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היתרה האמיתית שלך מתחת ל-%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш настоящий баланс ниже %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصيدك الحقيقي أقل من %@"
          }
        }
      }
    },
    "You’ll be notified if your true balance goes below zero.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu seras prévenu si ton vrai solde passe sous zéro."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תגיע התראה אם היתרה האמיתית תרד מתחת לאפס."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получите уведомление, если настоящий баланс станет ниже нуля."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيصلك تنبيه إذا انخفض رصيدك الحقيقي عن الصفر."
          }
        }
      }
    },
    "You’ll be notified when your true balance goes below this amount.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu seras prévenu quand ton vrai solde passe sous ce montant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תגיע התראה כשהיתרה האמיתית תרד מתחת לסכום הזה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получите уведомление, когда настоящий баланс опустится ниже этой суммы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيصلك تنبيه عندما ينخفض رصيدك الحقيقي عن هذا المبلغ."
          }
        }
      }
    },
    "You’ll be overdrawn on the debit date unless money comes in first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu seras à découvert le jour du prélèvement, sauf si de l’argent arrive avant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביום החיוב צפוי מינוס, אלא אם ייכנס כסף לפני כן."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В день списания вы уйдёте в минус, если до этого не поступят деньги."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيصبح رصيدك سالبًا يوم الخصم ما لم يصل مال قبل ذلك."
          }
        }
      }
    },
    "You’ll get a notification at 80% and 100%.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu seras prévenu à 80 % et à 100 %."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תגיע התראה ב-80% וב-100%."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получите уведомление при 80% и 100%."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيصلك تنبيه عند 80% و100%."
          }
        }
      }
    },
    "You’re using sample data.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu utilises des données d’exemple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצגים נתוני דוגמה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы используете демонстрационные данные."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم بيانات نموذجية."
          }
        }
      }
    },
    "about %@ each": {
