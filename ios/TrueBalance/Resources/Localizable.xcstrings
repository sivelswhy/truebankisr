            "value": "C’est tout ce que Leumi donne sur l’autre partie, y compris sur son site."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה כל מה שלאומי מוסר על הצד השני, גם באתר שלו."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это всё, что Леуми сообщает о другой стороне, в том числе на своём сайте."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا كل ما يقدّمه لئومي عن الطرف الآخر، وهو ما يظهر على موقعه أيضًا."
          }
        }
      }
    },
