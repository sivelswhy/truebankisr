    "iOS decides when background refresh runs. You can also pull down to refresh at any time.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS décide quand l’actualisation en arrière-plan a lieu. Tu peux aussi tirer vers le bas pour actualiser à tout moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏iOS מחליט מתי הרענון ברקע רץ. אפשר גם למשוך למטה כדי לרענן בכל רגע."
          }
        }
      }
    },
