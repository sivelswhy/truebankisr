        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد خصم ماكس في %1$@، سيصبح رصيدك %2$@."
          }
        }
      }
    },
    "After Max on %@, you’ll have %@. Updated %@.": {
