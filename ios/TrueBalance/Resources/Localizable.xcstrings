    "Set a monthly amount for a category, e.g. groceries ₪1,500. You’ll get a notification at 80% and 100%.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe un montant mensuel par catégorie, par exemple courses 1 500 ₪. Tu seras prévenu à 80 % et à 100 %."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובעים סכום חודשי לקטגוריה, למשל מכולת ‎₪1,500. תגיע התראה ב-80% וב-100%."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте сумму на месяц для категории, например продукты ₪1,500. Вы получите уведомление при 80% и 100%."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد مبلغًا شهريًا لفئة، مثلًا البقالة ₪1,500. سيصلك تنبيه عند 80% و100%."
          }
        }
      }
    },
    "Set a monthly budget per category": {
      "localizations": {
        "fr": {
