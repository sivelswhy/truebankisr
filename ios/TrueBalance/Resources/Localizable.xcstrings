            "value": "%@ в год"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سنويًا"
          }
        }
      }
    },
    "%@ account": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт в %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب %@"
          }
        }
      }
    },
    "%@ account (not counted, no rate)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte %@ (non compté, pas de taux)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון %@ (לא נכלל, אין שער)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт в %@ (не учтён: нет курса)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب %@ (غير محتسب، لا يوجد سعر صرف)"
          }
        }
      }
    },
    "%@ asked for an extra verification step. Sign in once on their website, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a demandé une vérification supplémentaire. Connecte-toi une fois sur leur site, puis réessaie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ביקשו שלב אימות נוסף. יש להתחבר פעם אחת באתר שלהם ואז לנסות שוב."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ запросил дополнительную проверку. Войдите один раз на его сайте, затем повторите попытку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب %@ خطوة تحقق إضافية. سجّل الدخول مرة واحدة على موقعه، ثم حاول مجددًا."
          }
        }
      }
    },
    "%@ asks you to change your password. Do it on their site, then sign in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te demande de changer ton mot de passe. Fais-le sur leur site, puis reconnecte-toi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ מבקשים להחליף סיסמה. יש להחליף אותה באתר שלהם ואז להתחבר שוב."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ просит сменить пароль. Смените его на сайте, затем войдите снова."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب %@ تغيير كلمة المرور. غيّرها على موقعه، ثم سجّل الدخول مجددًا."
          }
        }
      }
    },
    "%@ at the Bank of Israel rate": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ au taux de la Banque d’Israël"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לפי שער בנק ישראל"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ по курсу Банка Израиля"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ بسعر بنك إسرائيل"
          }
        }
      }
    },
    "%@ budget used up": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budget %@ épuisé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקציב של %@ נוצל"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бюджет «%@» исчерпан"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفدت ميزانية %@"
          }
        }
      }
    },
    "%@ didn’t accept this username or password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas accepté cet identifiant ou ce mot de passe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לא קיבלו את שם המשתמש או הסיסמה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не принял этот логин или пароль."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل %@ اسم المستخدم أو كلمة المرور هذه."
          }
        }
      }
    },
    "%@ left": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "reste %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נותרו %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متبقٍّ %@"
          }
        }
      }
    },
    "%@ over": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de dépassement"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חריגה של %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перерасход %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوز بمقدار %@"
          }
        }
      }
    },
    "%@ refused the connection from this network. This happens from abroad or through a VPN: turn the VPN off or try another network.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé la connexion depuis ce réseau. Cela arrive depuis l’étranger ou via un VPN : désactivez le VPN ou essayez un autre réseau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ דחו את החיבור מהרשת הזאת. זה קורה מחו״ל או דרך VPN: כדאי לכבות את ה-VPN או לנסות רשת אחרת."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отклонил подключение из этой сети. Так бывает за границей или через VPN: отключите VPN или попробуйте другую сеть."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض %@ الاتصال من هذه الشبكة. يحدث هذا من خارج البلاد أو عبر VPN: أوقف الـ VPN أو جرّب شبكة أخرى."
          }
        }
      }
    },
    "%@ so far": {
      "extractionState": "stale",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pour l’instant"
          }
        },
        "he": {
