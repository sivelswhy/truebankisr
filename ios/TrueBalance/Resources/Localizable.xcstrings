    "%@ asked for an extra verification step. Sign in once on their website, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a demandé une vérification supplémentaire. Connecte-toi une fois sur leur site, puis réessaie."
          }
        }
      }
    },
    "%@ asks you to change your password. Do it on their site, then sign in again.": {
      "localizations": {
        "fr": {
