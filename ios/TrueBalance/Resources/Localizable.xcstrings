            "value": "%@: נוצלו 80%% מהתקציב"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: использовано 80%% бюджета"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: استُخدم 80%% من الميزانية"
          }
        }
      }
    },
    "%@’s site is under maintenance or unavailable for now. Try again later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le site de %@ est en maintenance ou indisponible pour le moment. Réessayez plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האתר של %@ בתחזוקה או לא זמין כרגע. אפשר לנסות שוב מאוחר יותר."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт %@ на техобслуживании или сейчас недоступен. Повторите попытку позже."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موقع %@ قيد الصيانة أو غير متاح حاليًا. حاول لاحقًا."
          }
        }
      }
    },
