    "Shown in the Enable Banking portal. The key file is usually named after it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché dans le portail Enable Banking. Le fichier de clé porte généralement ce nom."
          }
