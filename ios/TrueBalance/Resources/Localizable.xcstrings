    "%@ spent this month out of %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ spent this month out of %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dépensés ce mois-ci sur %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החודש הוצאו %1$@ מתוך %2$@."
          }
        }
      }
    },
    "%@ took too long to respond. The connection may be slow or the site busy: try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a mis trop de temps à répondre. La connexion est peut-être lente ou le site surchargé : réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לא הגיבו בזמן. ייתכן שהחיבור איטי או שהאתר עמוס: אפשר לנסות שוב."
          }
        }
      }
    },
    "%@ took too long to respond. Try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
