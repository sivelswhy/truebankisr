      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "True Balance est verrouillé"
          }
        }
      }
    },
    "Try with sample data": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayer avec des données d’exemple"
          }
        }
      }
    },
    "Unlock": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouiller"
          }
        }
      }
    },
    "Unlock to see your balance": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouille pour voir ton solde"
          }
        }
      }
    },
    "Upcoming debits": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prochains prélèvements"
          }
        }
      }
    },
    "Updated %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis à jour %@"
          }
        }
      }
    },
    "Updating…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour…"
          }
        }
      }
    },
    "Used to greet you on the home screen.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour te saluer sur l’écran d’accueil."
          }
        }
      }
    },
    "Username": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiant"
          }
        }
      }
    },
    "When you open the app, and in the background": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’ouverture de l’app et en arrière-plan"
          }
        }
      }
    },
    "With later installments already committed: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En comptant les échéances suivantes déjà engagées : %@"
          }
        }
      }
    },
    "You stay signed in. Your credentials are kept in this iPhone’s Keychain.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu restes connecté. Tes identifiants sont gardés dans le trousseau de cet iPhone."
          }
        }
      }
    },
    "Your %@ account is blocked. Contact %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %1$@ account is blocked. Contact %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte %1$@ est bloqué. Contacte %2$@."
          }
        }
      }
    },
    "Your Leumi and Max credentials and the saved balance will be deleted from this iPhone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes identifiants Leumi et Max et le solde enregistré seront supprimés de cet iPhone."
          }
        }
      }
    },
    "Your credentials are stored in this iPhone’s Keychain and never leave it, except to sign in to Leumi and Max.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes identifiants sont stockés dans le trousseau de cet iPhone et n’en sortent jamais, sauf pour te connecter à Leumi et Max."
          }
        }
      }
    },
    "Your first name": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton prénom"
          }
        }
      }
    },
    "Your true balance is %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton vrai solde est de %@."
          }
        }
      }
    },
    "Your true balance is below %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton vrai solde est passé sous %@"
          }
        }
      }
    },
    "You’ll be notified if your true balance goes below zero.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu seras prévenu si ton vrai solde passe sous zéro."
          }
        }
      }
    },
    "You’ll be notified when your true balance goes below this amount.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu seras prévenu quand ton vrai solde passe sous ce montant."
          }
        }
      }
    },
    "You’ll be overdrawn on the debit date unless money comes in first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu seras à découvert le jour du prélèvement, sauf si de l’argent arrive avant."
          }
        }
      }
    },
    "You’re using sample data.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu utilises des données d’exemple."
          }
        }
      }
    },
    "about %@ each": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "environ %@ par achat"
          }
        }
      }
    },
    "about %@/day": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "environ %@/jour"
          }
        }
      }
