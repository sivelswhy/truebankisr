        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לא הגיבו בזמן. אפשר לנסות שוב."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ слишком долго не отвечал. Повторите попытку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق %@ وقتًا طويلًا للرد. حاول مجددًا."
          }
        }
      }
    },
