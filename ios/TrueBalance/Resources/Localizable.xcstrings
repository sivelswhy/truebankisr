    "After Max is debited on %@, your balance will be %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After Max is debited on %1$@, your balance will be %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après le prélèvement Max du %1$@, ton solde sera de %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחרי החיוב של מקס ב-%1$@, היתרה תהיה %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После списания Макса %1$@ ваш баланс составит %2$@."
