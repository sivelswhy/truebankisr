            "state": "translated",
            "value": "أُنفق %@"
          }
        }
      }
    },
    "%@ spent this month out of %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ spent this month out of %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dépensés ce mois-ci sur %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החודש הוצאו %1$@ מתוך %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом месяце потрачено %1$@ из %2$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنفق هذا الشهر %1$@ من أصل %2$@."
          }
        }
      }
    },
    "%@ took too long to respond. The connection may be slow or the site busy: try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a mis trop de temps à répondre. La connexion est peut-être lente ou le site surchargé : réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לא הגיבו בזמן. ייתכן שהחיבור איטי או שהאתר עמוס: אפשר לנסות שוב."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ слишком долго не отвечал. Возможно, связь медленная или сайт перегружен: повторите попытку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق %@ وقتًا طويلًا للرد. قد يكون الاتصال بطيئًا أو الموقع مزدحمًا: حاول مجددًا."
          }
        }
      }
    },
    "%@ took too long to respond. Try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a mis trop de temps à répondre. Réessaie."
